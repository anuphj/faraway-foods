---
import { Image } from "astro:assets";
const { item } = Astro.props;
const imgs = import.meta.glob("/src/assets/products/*.{jpg,jpeg,png,webp}", { eager: true }) as Record<string, { default: ImageMetadata }>;
const img = item.photo ? imgs[`/src/assets/products/${item.photo}`]?.default : undefined;
const inr = (n: number) => "₹" + n.toLocaleString("en-IN");
---
<article class="card">
  {img
    ? <Image src={img} alt={`${item.name}, ${item.size}`} widths={[400, 800]} sizes="(min-width: 760px) 33vw, 100vw" class="ph" />
    : <div class="ph" role="img" aria-label={`Photo of ${item.name} coming soon`}>Photo coming soon</div>}
  <h3>{item.name}</h3>
  <p>{item.size} · from {inr(item.tier1)}</p>
</article>
