---
import Base from "../../layouts/Base.astro";
import { policies } from "../../data/policies";
export function getStaticPaths() {
  return policies.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
---
<Base title={p.title}>
  <h1>{p.title}</h1>
  {p.draft && <div class="banner">Draft pending legal review.</div>}
  {p.body.map((t) => <p>{t}</p>)}
</Base>
