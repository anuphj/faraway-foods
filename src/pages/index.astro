---
import Base from "../layouts/Base.astro";
import OrderButton from "../components/OrderButton.astro";
import Tracker from "../components/Tracker.astro";
import ProductCard from "../components/ProductCard.astro";
import WaitlistBand from "../components/WaitlistBand.astro";
import { currentDrop } from "../data/drops";
const drop = currentDrop();
---
<Base wide>
  <section class="hero">
    <h1>Real pantry staples, straight from the source.</h1>
    <p class="lead">One country at a time, in limited drops. Pre-order early and pay less.</p>
    <div class="actions"><OrderButton open={drop?.status === "open"} /><a class="link" href="/how-it-works/">How drops work</a></div>
  </section>
  {drop && <section class="drop">
    <h2>Drop {drop.number}: {drop.title}</h2>
    {drop.stage !== null && <Tracker drop={drop} />}
    {drop.showItems
      ? <div class="grid">{drop.items.map((i) => <ProductCard item={i} showPrice={drop.showPrices} />)}</div>
      : <p class="lead" style="margin-top:28px">{drop.blurb}</p>}
    <p style="margin-top:28px"><a class="link" href={`/drops/${drop.slug}/`}>{!drop.showItems ? "See the drop details" : drop.showPrices ? "See the full drop and pricing tiers" : "See the full drop"}</a></p>
  </section>}
  <WaitlistBand slot="band" />
</Base>
