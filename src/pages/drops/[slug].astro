---
import Base from "../../layouts/Base.astro";
import PriceTable from "../../components/PriceTable.astro";
import OrderButton from "../../components/OrderButton.astro";
import Waitlist from "../../components/Waitlist.astro";
import { drops, statusLabel } from "../../data/drops";
export function getStaticPaths() {
  return drops.map((d) => ({ params: { slug: d.slug }, props: { d } }));
}
const { d } = Astro.props;
---
<Base title={`Drop ${d.number}: ${d.title}`} description={d.blurb}>
  <h1>Drop {d.number}: {d.title}</h1>
  <p class="lead">{statusLabel[d.status]}. {d.blurb}</p>
  {d.items.length > 0 && <>
    <h2>What’s in it</h2>
    <PriceTable items={d.items} />
    <p><OrderButton open={d.status === "open"} /></p>
  </>}
  {d.timeline.length > 0 && <>
    <h2>Where it is</h2>
    <ol class="timeline">{d.timeline.map((s) => <li class={s.done ? "done" : ""}>{s.label}{s.done ? " (done)" : ""}</li>)}</ol>
  </>}
  {d.items.length === 0 && <div class="panel"><h2>Where should we go next?</h2><p class="muted">Join the list and tell us the country or product you want.</p><Waitlist source={`drop-${d.slug}`} /></div>}
</Base>
