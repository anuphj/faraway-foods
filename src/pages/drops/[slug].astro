---
import Base from "../../layouts/Base.astro";
import PriceTable from "../../components/PriceTable.astro";
import OrderButton from "../../components/OrderButton.astro";
import Tracker from "../../components/Tracker.astro";
import Timeline from "../../components/Timeline.astro";
import ProductCard from "../../components/ProductCard.astro";
import WaitlistBand from "../../components/WaitlistBand.astro";
import { drops } from "../../data/drops";
export function getStaticPaths() {
  return drops.map((d) => ({ params: { slug: d.slug }, props: { d } }));
}
const { d } = Astro.props;
---
<Base title={`Drop ${d.number}: ${d.title}`} description={d.blurb} wide>
  <h1>Drop {d.number}: {d.title}</h1>
  <p class="lead">{d.blurb}</p>
  {d.stage !== null && <Tracker drop={d} />}
  {d.items.length > 0 && <>
    <div class="grid">{d.items.map((i) => <ProductCard item={i} />)}</div>
    <h2>Pricing tiers</h2>
    <PriceTable items={d.items} />
    <p><OrderButton open={d.status === "open"} /></p>
  </>}
  {d.stage !== null && <>
    <h2>Where this drop is</h2>
    <Timeline drop={d} />
  </>}
  {d.items.length === 0 && <p><a class="btn" href="/#join">Tell us where to go next</a></p>}
  <WaitlistBand slot="band" />
</Base>
